{
    "name": "diveshop365/silverstripe-lighthouse",
    "description": "Google PageSpeed Insights (Lighthouse) scores displayed in the CMS for pages, courses, and group trips",
    "type": "silverstripe-vendormodule",
    "license": "BSD-3-Clause",
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6.0",
        "silverstripe/cms": "^6.0",
        "guzzlehttp/guzzle": "^7.0",
        "symbiote/silverstripe-queuedjobs": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "DiveShop365\\Lighthouse\\": "src/"
        }
    },
    "extra": {
        "expose": [],
        "installer-name": "diveshop365/silverstripe-lighthouse"
    }
}
